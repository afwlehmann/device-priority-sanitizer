#!@bash@
#
# @raycast.schemaVersion 1
# @raycast.title Audio Priority: Set Input
# @raycast.mode silent
# @raycast.icon 🎙️
# @raycast.description Set the default input device by name.
# @raycast.author Alexander Lehmann
# @raycast.packageName Audio Priority Sanitizer
# @raycast.argument1 { "type": "text", "placeholder": "Input device name" }

set -euo pipefail
shopt -s inherit_errexit
# Note: errexit has exceptions inside if/&&/|| and pipelines — not used here.

exec @cli@ set input "$1"
